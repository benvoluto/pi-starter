# Copy to org.env (gitignored) and fill in. Get the real values from the team's
# private source (password manager / internal wiki) — never commit them.
#
# Install-time values: substituted into ~/.pi/agent/mcp.json by install.mjs.
# Leave one blank to skip that server.
GLEAN_HOST=            # your Glean host, e.g. <company>-be.<glean domain>
ASANA_MCP_CLIENT_ID=
SLACK_MCP_CLIENT_ID=
SLACK_MCP_CALLBACK_URL= # must exactly match the Slack app's registered redirect URI

# Gates optional providers. Not written to disk; pi reads ${REFLECTION_API_KEY}
# from your environment at runtime, so also export it in your shell profile.
REFLECTION_API_KEY=

# Runtime-only secrets (export in your shell profile; NOT read from this file):
#   ASANA_MCP_CLIENT_SECRET
